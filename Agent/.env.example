# =============================================================================
# AI 服务环境变量模板（复制为 .env 后填写；.env 已加入 .gitignore）
# =============================================================================

# ---- 大模型（火山方舟 Ark，OpenAI 兼容协议） ----
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-pro-ga-260813

# ---- 服务 ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
SPRING_CALLBACK_TOKEN=witpath-internal-token

# ---- PostgreSQL（LangGraph 检查点持久化，可选） ----
PG_DSN=postgresql://admin:admin123@192.168.88.130:5432/witpath_ai
PG_ENABLED=false

# ---- Milvus（向量检索，可选） ----
MILVUS_HOST=192.168.88.130
MILVUS_PORT=19530
MILVUS_COLLECTION=witpath_docs
MILVUS_ENABLED=false

# ---- 阿里云 OSS（资料读取，可选） ----
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENABLED=false

# ---- Embedding ----
# provider=ollama：使用本机 Ollama（需先 ollama pull bge-m3）
# provider=ark  ：使用火山方舟在线向量模型（需账号已开通对应模型）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
OLLAMA_HOST=http://127.0.0.1:11434
